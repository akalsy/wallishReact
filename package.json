{
  "name": "wallish-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "用每日壁纸学英语",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,app \"vite --port 5173 --strictPort\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "pack:mac": "vite build && electron-builder --mac dir"
  },
  "build": {
    "appId": "org.wallish.desktop",
    "productName": "Wallish",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "dist/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "assets/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
